<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MkvAudioSwap.App.Dialogs.CompletionDialog"
        Title="完成"
        Width="520" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
        Background="#F5F1E8">

  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#4A7560" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3C6250" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#5C5449" />
      <Setter Property="BorderBrush" Value="#E2DCCD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0EBE0" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#6F6659" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="26,24,26,22" Spacing="16">

    <!-- 标题区 -->
    <StackPanel Orientation="Horizontal" Spacing="11">
      <Border Width="38" Height="38" CornerRadius="19" Background="#E4EDE6"
              VerticalAlignment="Center">
        <TextBlock Text="✓" FontSize="19" FontWeight="Bold" Foreground="#4A7560"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="替换完成" FontSize="16" FontWeight="SemiBold" Foreground="#2E2923" />
        <TextBlock Name="DetailText" FontSize="12" Foreground="#6F6659" />
      </StackPanel>
    </StackPanel>

    <!-- 输出路径 -->
    <Border Background="#FBF8F2" BorderBrush="#E2DCCD" BorderThickness="1"
            CornerRadius="10" Padding="13,11">
      <StackPanel Spacing="6">
        <TextBlock Text="输出文件" FontSize="11.5" Foreground="#6F6659" />
        <TextBlock Name="PathText" FontFamily="Consolas, Cascadia Mono, monospace"
                   FontSize="12" Foreground="#2E2923" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- 提示 -->
    <TextBlock Text="画面与声音都是原样拷贝进新容器的，没有经过任何重新编码。"
               FontSize="11.5" Foreground="#6F6659" TextWrapping="Wrap" />

    <!-- 操作 -->
    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
      <Button Grid.Column="0" Name="RevealButton" Classes="primary" Content="打开所在文件夹"
              Click="OnReveal" />
      <Button Grid.Column="1" Name="PlayButton" Classes="ghost" Content="播放"
              Click="OnPlay" Margin="10,0,0,0" />
      <Button Grid.Column="3" Name="AgainButton" Classes="ghost" Content="再处理一个"
              Click="OnAgain" VerticalAlignment="Center" />
    </Grid>
  </StackPanel>
</Window>
