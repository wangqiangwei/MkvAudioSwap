<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:MkvAudioSwap.App"
        x:Class="MkvAudioSwap.App.Dialogs.NoticesDialog"
        Title="提醒"
        Icon="/Assets/app.png"
        Width="640" Height="540"
        SizeToContent="Manual"
        CanResize="True"
        MinWidth="520" MinHeight="380"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24,22,24,20">

    <!-- 标题 -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,14">
      <Border Classes="sectionTile">
        <Grid>
          <Path Name="CautionIcon" Data="{StaticResource IconWarning}"
                Stroke="{StaticResource WarnTextBrush}" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Path Name="InfoIcon" Data="{StaticResource IconInfo}" IsVisible="False"
                Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Spacing="3" Margin="11,0,0,0" VerticalAlignment="Center">
        <TextBlock Name="TitleText" Classes="dialogTitle" />
        <TextBlock Name="SubtitleText" Classes="dialogSubtitle" />
      </StackPanel>
    </Grid>

    <!-- 清单 -->
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="4">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Border Padding="12,10">
          <ItemsControl Name="NoticeList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                  <Path Data="{StaticResource IconWarning}" IsVisible="{Binding IsCautionOnly}"
                        Stroke="{Binding Brush}" StrokeThickness="1.7"
                        StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                        Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                  <Path Data="{StaticResource IconBlocked}" IsVisible="{Binding IsDanger}"
                        Stroke="{Binding Brush}" StrokeThickness="1.7"
                        StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                        Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                  <Ellipse IsVisible="{Binding IsInfo}" Width="6" Height="6"
                           Fill="{Binding Brush}" VerticalAlignment="Top" Margin="4,7,0,0" />

                  <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{StaticResource TextBrush}" LineHeight="19" />
                    <Border Classes="chip" IsVisible="{Binding HasSource}"
                            HorizontalAlignment="Left" Background="{StaticResource ChipBrush}">
                      <TextBlock Text="{Binding Source}" FontSize="10"
                                 Foreground="{StaticResource MutedBrush}" />
                    </Border>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </ScrollViewer>
    </Border>

    <!-- 底部 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <TextBlock Grid.Column="0" Name="FooterText" FontSize="10.5"
                 Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                 VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Grid.Column="1" Classes="primary compact" Content="知道了" Click="OnClose"
              VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
