<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MkvAudioSwap.App.App"
             RequestedThemeVariant="Light">

  <!--
    ══════════════════════════════════════════════════════════════════
    替音工具 · 设计系统（暖米黄「精装版」）
    ──────────────────────────────────────────────────────────────────
    色值不是随便挑的：正文三档都按 WCAG AA（4.5:1）重新核算过。
    2026-10 复核发现旧版「第三层 #7A7164 对页面底 4.9:1」算错了，
    实测只有 4.26:1；这里改为 #746B5E（对页面底 4.65:1）。
    改任何文字色之前，先看 docs/UI规范.md 里的对照表。
    ══════════════════════════════════════════════════════════════════
  -->

  <Application.Resources>
    <!-- ── 字体 ── -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- ── 背景与面 ── -->
    <SolidColorBrush x:Key="PageBrush" Color="#F5F1E8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FBF8F2" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFCF6" />
    <SolidColorBrush x:Key="SunkenBrush" Color="#F0EBE0" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EFE9DA" />
    <SolidColorBrush x:Key="ChipBrush" Color="#F1ECE2" />
    <SolidColorBrush x:Key="DividerBrush" Color="#ECE5D6" />

    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#F8F4EC" Offset="0" />
      <GradientStop Color="#F4EFE5" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#FFFDF9" Offset="0" />
      <GradientStop Color="#FAF6EE" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SummaryBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#FCF9F3" Offset="0" />
      <GradientStop Color="#F8F4EC" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#4F7C66" Offset="0" />
      <GradientStop Color="#446D5A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#436F5A" Offset="0" />
      <GradientStop Color="#395F4E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopGlowBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#22FFFFFF" Offset="0" />
      <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- ── 线 ── -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E2DCCD" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFC6B2" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#E6DFD0" />

    <!-- ── 文字（三档） ── -->
    <SolidColorBrush x:Key="TextBrush" Color="#2E2923" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6F6659" />
    <SolidColorBrush x:Key="FaintBrush" Color="#746B5E" />
    <SolidColorBrush x:Key="SpecBrush" Color="#5C5449" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- ── 强调与语义 ── -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4A7560" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3C6250" />
    <SolidColorBrush x:Key="AccentPressBrush" Color="#2F4A3D" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4EDE6" />
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#CFE0D5" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3F6B52" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#2F5A43" />
    <SolidColorBrush x:Key="WarnBrush" Color="#8A5F14" />
    <SolidColorBrush x:Key="WarnTextBrush" Color="#7A5512" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#F7F1E4" />
    <SolidColorBrush x:Key="WarnSoftBorderBrush" Color="#E8DCC0" />
    <SolidColorBrush x:Key="DangerBrush" Color="#A8402C" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#943725" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F7E7E2" />
    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#E0BDB3" />

    <!-- ── 状态胶囊 ── -->
    <SolidColorBrush x:Key="PillReadyBackground" Color="#E4EDE6" />
    <SolidColorBrush x:Key="PillReadyBorder" Color="#CFE0D5" />
    <SolidColorBrush x:Key="PillReadyForeground" Color="#2F5A43" />
    <SolidColorBrush x:Key="PillWarnBackground" Color="#F7F1E4" />
    <SolidColorBrush x:Key="PillWarnBorder" Color="#E8DCC0" />
    <SolidColorBrush x:Key="PillWarnForeground" Color="#7A5512" />
    <SolidColorBrush x:Key="PillBlockedBackground" Color="#F7E7E2" />
    <SolidColorBrush x:Key="PillBlockedBorder" Color="#E0BDB3" />
    <SolidColorBrush x:Key="PillBlockedForeground" Color="#943725" />

    <!-- ── 图标几何（24 × 24，线条为主） ── -->
    <StreamGeometry x:Key="IconSwap">M4 8 H17 M14 5 L17 8 L14 11 M20 16 H7 M10 13 L7 16 L10 19</StreamGeometry>
    <StreamGeometry x:Key="IconShield">M12 3 L20 6 V12 C20 17 16 20 12 21 C8 20 4 17 4 12 V6 Z M8.5 12 L11 14.5 L15.5 9.5</StreamGeometry>
    <StreamGeometry x:Key="IconGear">M12 8.5 A3.5 3.5 0 1 0 12 15.5 A3.5 3.5 0 1 0 12 8.5 M12 2.5 V4.5 M12 19.5 V21.5 M2.5 12 H4.5 M19.5 12 H21.5 M4.9 4.9 L6.3 6.3 M17.7 17.7 L19.1 19.1 M19.1 4.9 L17.7 6.3 M6.3 17.7 L4.9 19.1</StreamGeometry>
    <StreamGeometry x:Key="IconVideo">M5.5 5 H18.5 A2.5 2.5 0 0 1 21 7.5 V16.5 A2.5 2.5 0 0 1 18.5 19 H5.5 A2.5 2.5 0 0 1 3 16.5 V7.5 A2.5 2.5 0 0 1 5.5 5 Z M10 9 L15.5 12 L10 15 Z</StreamGeometry>
    <StreamGeometry x:Key="IconAudio">M4 10 V14 M7.5 7.5 V16.5 M11 4.5 V19.5 M14.5 7 V17 M18 9 V15 M21 11.5 V12.5</StreamGeometry>
    <StreamGeometry x:Key="IconFile">M6 3 H14 L19 8 V21 H6 Z M14 3 V8 H19</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M3 7.5 A2.5 2.5 0 0 1 5.5 5 H9 L11 7.5 H18.5 A2.5 2.5 0 0 1 21 10 V17.5 A2.5 2.5 0 0 1 18.5 20 H5.5 A2.5 2.5 0 0 1 3 17.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M5 12.5 L10 17.5 L19 7.5</StreamGeometry>
    <StreamGeometry x:Key="IconWarning">M12 3.5 L21 20 H3 Z M12 9 V14.5 M12 17.2 V17.21</StreamGeometry>
    <StreamGeometry x:Key="IconBlocked">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M5.6 5.6 L18.4 18.4</StreamGeometry>
    <StreamGeometry x:Key="IconInfo">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M12 10 V16 M12 7 V7.01</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M6 6 L18 18 M18 6 L6 18</StreamGeometry>
    <StreamGeometry x:Key="IconArrowRight">M4 12 H20 M14 6 L20 12 L14 18</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M9 6 L15 12 L9 18</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M8 5 L19 12 L8 19 Z</StreamGeometry>
    <StreamGeometry x:Key="IconCopy">M9 9 H19 A1 1 0 0 1 20 10 V19 A1 1 0 0 1 19 20 H9 A1 1 0 0 1 8 19 V10 A1 1 0 0 1 9 9 Z M5 15 V5 A1 1 0 0 1 6 4 H15</StreamGeometry>
    <StreamGeometry x:Key="IconExternal">M14 4 H20 V10 M20 4 L12 12 M18 14 V19 A1 1 0 0 1 17 20 H5 A1 1 0 0 1 4 19 V7 A1 1 0 0 1 5 6 H10</StreamGeometry>
    <StreamGeometry x:Key="IconRefresh">M20 6 V11 H15 M4 18 V13 H9 M5.5 9 A7 7 0 0 1 18.5 7 M18.5 15 A7 7 0 0 1 5.5 17</StreamGeometry>
    <StreamGeometry x:Key="IconWave">M3 12 H5 L7 8 L10 16 L13 6 L16 18 L18 12 H21</StreamGeometry>
    <StreamGeometry x:Key="IconClock">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M12 7 V12 L15.5 14</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M12 5 V19 M5 12 H19</StreamGeometry>
    <StreamGeometry x:Key="IconMinus">M5 12 H19</StreamGeometry>
    <StreamGeometry x:Key="IconSparkle">M12 3 L13.8 9.2 L20 11 L13.8 12.8 L12 19 L10.2 12.8 L4 11 L10.2 9.2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSliders">M4 7 H20 M4 12 H20 M4 17 H20 M8 5 V9 M16 10 V14 M10 15 V19</StreamGeometry>

    <!-- ── 空状态线稿（96 × 96） ── -->
    <StreamGeometry x:Key="EmptyVideoArt">M18 24 H78 A10 10 0 0 1 88 34 V62 A10 10 0 0 1 78 72 H18 A10 10 0 0 1 8 62 V34 A10 10 0 0 1 18 24 Z M40 38 L60 48 L40 58 Z</StreamGeometry>
    <StreamGeometry x:Key="EmptyVideoSpark">M78 10 L80.5 17 L87.5 19.5 L80.5 22 L78 29 L75.5 22 L68.5 19.5 L75.5 17 Z</StreamGeometry>
    <StreamGeometry x:Key="EmptyAudioArt">M14 48 V48 M22 38 V58 M30 28 V68 M38 34 V62 M46 20 V76 M54 36 V60 M62 28 V68 M70 38 V58 M78 44 V52 M86 48 V48</StreamGeometry>
    <StreamGeometry x:Key="EmptyAudioSpark">M78 10 L80.5 17 L87.5 19.5 L80.5 22 L78 29 L75.5 22 L68.5 19.5 L75.5 17 Z</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
    </Style>

    <!-- ══════════════ 文字层级 ══════════════ -->
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.dialogTitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.dialogSubtitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.tiny">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.faint">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
    </Style>

    <Style Selector="TextBlock.spec">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource SpecBrush}" />
    </Style>

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="Foreground" Value="{StaticResource SpecBrush}" />
    </Style>

    <Style Selector="TextBlock.fileName">
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
    </Style>

    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.emptyTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.timelineLabel">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══════════════ 按钮 ══════════════ -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="0,14" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PrimaryButtonHoverBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentPressBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Foreground" Value="{StaticResource SpecBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#E6E1D4" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource SpecBrush}" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource SpecBrush}" />
      <Setter Property="BorderBrush" Value="#D8D0BF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="0,10" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <!-- 弹窗里的紧凑按钮：同一套主/次样式，只缩小尺寸 -->
    <Style Selector="Button.primary.compact">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.ghost.compact">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style Selector="Border.sectionTile">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SunkenBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource HoverBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    </Style>

    <Style Selector="Button.notice">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource WarnSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.notice:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F2E8D5" />
      <Setter Property="BorderBrush" Value="#DCCBAA" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource WarnTextBrush}" />
    </Style>

    <Style Selector="Button.preset">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{StaticResource SpecBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.preset:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessTextBrush}" />
    </Style>

    <Style Selector="Button.offsetEntry">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.offsetEntry:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.offsetEntry.active">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.cardBody">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.cardBody:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0A4A7560" />
    </Style>

    <!-- ══════════════ 卡片与面板 ══════════════ -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20,17" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #0D2E2923, 0 12 30 -20 #1F2E2923" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="RenderTransform" Value="scale(1.003)" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #0F2E2923, 0 16 34 -20 #262E2923" />
    </Style>
    <Style Selector="Border.card.dropping">
      <Setter Property="Background" Value="{StaticResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="RenderTransform" Value="scale(1.008)" />
      <Setter Property="BoxShadow" Value="0 0 0 4 #1F4A7560, 0 16 34 -20 #2E4A7560" />
    </Style>

    <Style Selector="Border.summary">
      <Setter Property="Background" Value="{StaticResource SummaryBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #0A2E2923" />
    </Style>

    <Style Selector="Border.dialogCard">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{StaticResource ChipBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style Selector="Border.stepBadge">
      <Setter Property="Background" Value="{StaticResource ChipBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.iconTile">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.brandTile">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BoxShadow" Value="0 2 6 0 #1F2F4A3D" />
    </Style>

    <Style Selector="Border.infoCard">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="Border.warnCard">
      <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource WarnSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="Border.dangerCard">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="Border.emptyArt">
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="96" />
      <Setter Property="CornerRadius" Value="48" />
      <Setter Property="Background" Value="#F2EDE2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ══════════════ 图标 ══════════════ -->
    <Style Selector="Path.icon">
      <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.iconSmall">
      <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.iconTiny">
      <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══════════════ 输入 ══════════════ -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="SelectionBrush" Value="#B9D3C5" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover">
      <Setter Property="BorderBrush" Value="#BFB5A0" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <!-- ══════════════ 进度 ══════════════ -->
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="#E4DFD2" />
    </Style>

    <!-- ══════════════ 滚动条 ══════════════ -->
    <Style Selector="ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
